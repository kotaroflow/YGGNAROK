  "scripts": {
    "dev": "next dev",
    "dev:council": "node scripts/dev-council.mjs",
    "council:doctor": "node scripts/council-doctor.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker:dev": "tsx worker/src/index.ts",
    "worker:once": "tsx worker/src/index.ts --once",
